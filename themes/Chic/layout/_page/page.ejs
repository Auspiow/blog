<div class="container">
    <% if (page.show_toc === true && theme.post_toc_enable && toc(page.content).length !== 0) { %>
        <%- partial('_partial/toc') %>
    <% } %>
    <article class="post-wrap page">
        <% if (theme.page_title_enable && page.show_title !== false){ %>
        <h2 class="post-title"><%- page.title %></h2>
        <% } %>
        <section class="post-content">
            <%- page.content %>
        </section>
    </article>
</div>